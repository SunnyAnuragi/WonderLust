<% layout("/layouts/boilerplate.ejs") %>

<div class="row mt-4 justify-content-center">
  <!-- Listing Title area -->
  <div class="col-lg-9 col-md-11 col-12 show-title-area">
    <h3 class="fw-bold mb-1 text-dark"><%= listing.title %></h3>
  </div>

  <!-- Listing Hero Cover Image -->
  <div class="col-lg-9 col-md-11 col-12">
    <div class="hero-img-wrapper">
      <img
        src="<%= listing.image.url %>"
        alt="listing cover image"
        class="img-fluid w-100"
      />
    </div>
  </div>

  <!-- Main Info / Map Split Layout -->
  <div class="col-lg-9 col-md-11 col-12">
    <div class="row g-4">
      
      <!-- Left Info Column -->
      <div class="col-md-7 col-12">
        <div class="show-detail-card">
          <!-- Host/Owner Details -->
          <div class="show-owner-info">
            <i class="fa-solid fa-circle-user fs-2 text-muted"></i>
            <div>
              <span class="text-muted d-block small">Hosted by</span>
              <h5><%= listing.owner.username %></h5>
            </div>
          </div>

          <!-- Description -->
          <p class="show-description"><%= listing.description %></p>

          <!-- Listing Metadata details -->
          <ul class="show-meta-info mt-4">
            <li class="d-flex align-items-center gap-2">
              <i class="fa-solid fa-indian-rupee-sign text-dark"></i>
              <span class="fs-5 fw-bold"> <%= listing.price.toLocaleString("en-IN") %> <span class="fs-6 fw-normal text-muted">/ night</span></span>
            </li>
            <li class="d-flex align-items-center gap-2 mt-2">
              <i class="fa-solid fa-map-pin"></i>
              <span><%= listing.location %></span>
            </li>
            <li class="d-flex align-items-center gap-2">
              <i class="fa-solid fa-globe"></i>
              <span><%= listing.country %></span>
            </li>
          </ul>
        </div>

        <!-- Edit/Delete Action Controls for Owner -->
        <% if (currentUser && currentUser._id.equals(listing.owner._id)) { %>
          <div class="d-flex gap-3 mb-4">
            <a
              href="/listings/<%= listing._id %>/edit"
              class="btn btn-dark-redesign px-4 py-2 flex-grow-1"
            >
              Edit Details
            </a>

            <form
              method="POST"
              action="/listings/<%= listing._id %>?_method=DELETE"
              class="flex-grow-1"
            >
              <button class="btn btn-accent w-100 px-4 py-2">
                Delete Listing
              </button>
            </form>
          </div>
        <% } %>
      </div>

      <!-- Right Map Column -->
      <div class="col-md-5 col-12">
        <div class="map-card h-100 p-3 bg-white border border-light-subtle shadow-sm">
          <h5 class="fw-bold mb-3"><i class="fa-solid fa-map-location-dot me-2 text-muted"></i>Where you'll be</h5>
          <!-- MAP CONTAINER -->
          <div id="map" data-coordinates="<%= JSON.stringify(listing.geometry && listing.geometry.coordinates ? listing.geometry.coordinates : [77.209, 28.613]) %>" class="w-100 rounded-3" style="height: 320px;"></div>
        </div>
      </div>
      
    </div>
  </div>

  <!-- Reviews Section -->
  <div class="col-lg-9 col-md-11 col-12 mt-4 mb-5">
    <hr class="my-4 border-light-subtle" />

    <div class="row">
      <!-- Left: Create Review Form -->
      <% if (currentUser) { %>
        <div class="col-md-5 col-12 mb-4">
          <h4 class="fw-bold mb-3">Leave a Review</h4>
          <form
            action="/listings/<%= listing.id %>/reviews"
            method="POST"
            novalidate
            class="needs-validation form-card p-4 m-0"
          >
            <!-- Rating Starability Select -->
            <div class="mb-3">
              <label class="form-label d-block">Rating</label>
              <fieldset class="starability-slot">
                <!-- 1 Star -->
                <input
                  type="radio"
                  id="first-rate1"
                  name="review[rating]"
                  value="1"
                  checked
                />
                <label for="first-rate1" title="Terrible">1 star</label>

                <!-- 2 Stars -->
                <input
                  type="radio"
                  id="first-rate2"
                  name="review[rating]"
                  value="2"
                />
                <label for="first-rate2" title="Not good">2 stars</label>

                <!-- 3 Stars -->
                <input
                  type="radio"
                  id="first-rate3"
                  name="review[rating]"
                  value="3"
                />
                <label for="first-rate3" title="Average">3 stars</label>

                <!-- 4 Stars -->
                <input
                  type="radio"
                  id="first-rate4"
                  name="review[rating]"
                  value="4"
                />
                <label for="first-rate4" title="Very good">4 stars</label>

                <!-- 5 Stars -->
                <input
                  type="radio"
                  id="first-rate5"
                  name="review[rating]"
                  value="5"
                />
                <label for="first-rate5" title="Amazing">5 stars</label>
              </fieldset>
            </div>

            <!-- Comment -->
            <div class="mb-3">
              <label for="comment" class="form-label">Review Comment</label>
              <textarea
                name="review[comment]"
                id="comment"
                class="form-control"
                cols="30"
                rows="4"
                placeholder="Share your stay experience..."
                required
              ></textarea>
              <div class="invalid-feedback">
                Please add a comment before submitting.
              </div>
            </div>

            <!-- Submit -->
            <button class="btn btn-accent w-100 py-2">
              Submit Review
            </button>
          </form>
        </div>
      <% } %>

      <!-- Right: Reviews List Timeline -->
      <div class="<%= currentUser ? 'col-md-7' : 'col-12' %> col-12">
        <% if (listing.reviews.length > 0) { %>
          <h4 class="fw-bold mb-3">Guest Reviews (<%= listing.reviews.length %>)</h4>
          <div class="row g-3">
            <% for (review of listing.reviews) { %>
              <div class="col-sm-6 col-12">
                <div class="review-card h-100 d-flex flex-column justify-content-between">
                  <div>
                    <div class="d-flex align-items-center gap-2 mb-2">
                      <i class="fa-solid fa-circle-user text-muted fs-4"></i>
                      <h6 class="review-author m-0">
                        @<%= review.author ? review.author.username : "Anonymous" %>
                      </h6>
                    </div>
                    
                    <!-- Starability Result star render -->
                    <p
                      class="starability-result mb-2"
                      data-rating="<%= review.rating %>"
                    >
                      Rated: <%= review.rating %> stars
                    </p>
                    
                    <p class="review-comment"><%= review.comment %></p>
                  </div>

                  <!-- Author-only delete review button -->
                  <% if (currentUser && review.author && currentUser._id.equals(review.author._id)) { %>
                    <form
                      method="POST"
                      class="m-0 text-end"
                      action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
                    >
                      <button class="btn btn-sm btn-outline-dark-redesign px-3 py-1 mt-2">
                        <i class="fa-solid fa-trash me-1"></i>Delete
                      </button>
                    </form>
                  <% } %>
                </div>
              </div>
            <% } %>
          </div>
        <% } else { %>
          <div class="empty-state p-4 text-center border rounded-3 bg-light my-3">
            <i class="fa-regular fa-comment-dots fs-3 text-muted mb-2 d-block"></i>
            <h6 class="fw-bold text-dark m-0">No reviews yet</h6>
            <p class="text-muted small m-0">Be the first to share your thoughts on this place.</p>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>

<script type="module" src="/js/map.js"></script>