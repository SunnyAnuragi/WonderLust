<% layout("/layouts/boilerplate.ejs") %>

<div class="row mt-3">

  <!-- Listing Title -->
  <div class="col-8 offset-3">
    <h3><%= listing.title %></h3>
  </div>

  <!-- Listing Card -->
  <div class="card show-card col-6 offset-3 mt-3 listing-card">

    <img
      class="card-img-top show-img"
      src="<%= listing.image.url %>"
      alt="listing img"
    />

    <div class="card-body">
      <div class="card-text">

        <p>
          Owned By -
          <i><%= listing.owner.username %></i>
        </p>

        <p><%= listing.description %></p>

        <p>
          &#8377;
          <%= listing.price.toLocaleString("en-IN") %>
        </p>

        <p><%= listing.location %></p>

        <p><%= listing.country %></p>

      </div>
    </div>
  </div>

   <!-- MAP -->
  <div class="col-6 offset-3 mt-4 mb-4">

    <h4>Where you'll be</h4>

    <div id="map" data-coordinates="<%= JSON.stringify(listing.geometry && listing.geometry.coordinates ? listing.geometry.coordinates : [77.209, 28.613]) %>"></div>
  </div>

  <!-- Edit / Delete buttons for Owner -->
  <% if (currentUser && currentUser._id.equals(listing.owner._id)) { %>

    <div class="btns">

      <a
        href="/listings/<%= listing._id %>/edit"
        class="btn btn-dark edit-btn col-1 offset-3"
      >
        Edit
      </a>

      <form
        method="POST"
        action="/listings/<%= listing._id %>?_method=DELETE"
      >
        <button class="btn btn-dark offset-5">
          Delete
        </button>
      </form>

    </div>

  <% } %>


  <!-- Reviews Section -->
  <div class="col-8 offset-3 mb-3">

    <!-- Leave a Review -->
    <% if (currentUser) { %>

      <h4>Leave a Review</h4>

      <form
        action="/listings/<%= listing.id %>/reviews"
        method="POST"
        novalidate
        class="needs-validation"
      >

        <!-- Rating -->
        <div class="mb-3 mt-3">

          <label class="form-label">
            Rating
          </label>

          <fieldset class="starability-slot">

            <!-- No Rating -->
            <!-- <input
              type="radio"
              id="first-rate1"
              class="input-no-rate"
              name="review[rating]"
              value="1"
              checked
              aria-label="No rating."
            /> -->

            <!-- 1 Star -->
            <input
              type="radio"
              id="first-rate1"
              name="review[rating]"
              value="1"
              checked
            />
            <label
              for="first-rate1"
              title="Terrible"
            >
              1 star
            </label>

            <!-- 2 Stars -->
            <input
              type="radio"
              id="first-rate2"
              name="review[rating]"
              value="2"
            />
            <label
              for="first-rate2"
              title="Not good"
            >
              2 stars
            </label>

            <!-- 3 Stars -->
            <input
              type="radio"
              id="first-rate3"
              name="review[rating]"
              value="3"
            />
            <label
              for="first-rate3"
              title="Average"
            >
              3 stars
            </label>

            <!-- 4 Stars -->
            <input
              type="radio"
              id="first-rate4"
              name="review[rating]"
              value="4"
            />
            <label
              for="first-rate4"
              title="Very good"
            >
              4 stars
            </label>

            <!-- 5 Stars -->
            <input
              type="radio"
              id="first-rate5"
              name="review[rating]"
              value="5"
            />
            <label
              for="first-rate5"
              title="Amazing"
            >
              5 stars
            </label>

          </fieldset>

        </div>


        <!-- Comment -->
        <div class="mb-3 mt-3">

          <label
            for="comment"
            class="form-label"
          >
            Comment
          </label>

          <textarea
            name="review[comment]"
            id="comment"
            class="form-control"
            cols="30"
            rows="5"
            required
          ></textarea>

          <div class="invalid-feedback">
            Submit valid review
          </div>

        </div>


        <!-- Submit -->
        <button class="btn btn-outline-dark">
          Submit
        </button>

      </form>

    <% } %>


    <!-- Reviews -->
    <% if (listing.reviews.length > 0) { %>
    <h4>Reviews</h4>

    <div class="row">

      <% for (review of listing.reviews) { %>

        <div class="card col-5 ms-3 mb-3">

          <div class="card-body">

            <!-- Review Author -->
            <h5 class="card-title">
              @
              <%= review.author
                ? review.author.username
                : "Anonymous"
              %>
            </h5>


            <!-- Star Rating -->
            <p
              class="starability-result"
              data-rating="<%= review.rating %>"
            >
              Rated: <%= review.rating %> stars
            </p>


            <!-- Comment -->
            <p class="card-text">
              <%= review.comment %>
            </p>

          </div>


          <!-- Delete Review -->
          <form
            method="POST"
            class="mb-3"
            action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
          >

            <button class="btn btn-sm btn-dark">
              Delete
            </button>

          </form>

        </div>

      <% } %>

    </div>
  <% } %>
  </div>

</div>


<script type="module" src="/js/map.js"></script>