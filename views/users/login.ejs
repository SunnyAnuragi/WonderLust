<% layout("/layouts/boilerplate.ejs") %>

<div class="row mt-4 justify-content-center">
  <div class="col-lg-5 col-md-7 col-12">
    <div class="form-card">
      <h3 class="fw-bold mb-1"><i class="fa-solid fa-lock me-2 text-muted"></i>Welcome Back</h3>
      <p class="text-muted small mb-4">LogIn to manage your property listings and reviews.</p>
      
      <form action="/login" method="POST" class="needs-validation" novalidate>
        <!-- Username -->
        <div class="mb-3">
          <label for="username" class="form-label">Username</label>
          <input
            name="username"
            id="username"
            type="text"
            class="form-control"
            placeholder="Enter your username"
            required
          />
          <div class="invalid-feedback">Please enter a valid username.</div>
        </div>

        <!-- Password -->
        <div class="mb-3">
          <label for="password" class="form-label">Password</label>
          <input
            name="password"
            id="password"
            type="password"
            class="form-control"
            placeholder="Enter your password"
            required
          />
          <div class="invalid-feedback">Please enter your password.</div>
        </div>

        <!-- Submit Button -->
        <button class="btn btn-accent w-100 py-2.5 mt-3 fs-6">
          LogIn
        </button>
      </form>
    </div>
  </div>
</div>
